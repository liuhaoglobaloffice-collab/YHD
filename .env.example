# LiuHao AI OS environment template
SECRET_KEY=change-me-please-use-a-long-random-value
JWT_SECRET_KEY=change-me-please-use-a-long-random-value
DATABASE_URL=sqlite+aiosqlite:///./dev.db
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=liuhao_ai_os
POSTGRES_USER=liuhao_user
POSTGRES_PASSWORD=change-me

# OpenAI / LLM Provider
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (local LLM alternative)
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_ENABLED=false

# ==================== P0-3 获客数据源凭据（可选）====================
# 不配置时获客引擎诚实返回 MOCK 示例数据（source_type=MOCK）；
# 配置后 Google 源走真实 Custom Search API（source_type=REAL）。
# GOOGLE_SEARCH_API_KEY=your-google-custom-search-api-key
# GOOGLE_SEARCH_CX=your-google-custom-search-engine-id
# 海关数据源：配置后走真实海关数据 API（source_type=REAL）
# CUSTOMS_API_URL=https://your-customs-data-provider.example.com/api

PYTHONPATH=.
