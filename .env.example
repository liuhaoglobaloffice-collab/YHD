# Environment Configuration Example
# Copy this to .env and fill in your actual values
# NEVER commit .env to Git

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=liuhao_ai_os
POSTGRES_USER=liuhao_user
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
SECRET_KEY=change_me_to_random_secure_key_min_32_chars
JWT_SECRET_KEY=change_me_to_random_secure_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Policy Defaults (Fail Closed)
POLICY_DEFAULT_DENY=true
POLICY_UNKNOWN_DENY=true

# Feature Flags (Security First - all disabled by default)
FEATURE_PROVIDER_GATEWAY=false
FEATURE_NETWORK_GATEWAY=false
FEATURE_BROWSER_GATEWAY=false
FEATURE_EXTERNAL_TOOLS=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
