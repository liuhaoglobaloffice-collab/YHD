# LiuHao AI OS environment template
SECRET_KEY=change-me-please-use-a-long-random-value
JWT_SECRET_KEY=change-me-please-use-a-long-random-value
DATABASE_URL=sqlite+aiosqlite:///./dev.db
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=liuhao_ai_os
POSTGRES_USER=liuhao_user
POSTGRES_PASSWORD=change-me

# OpenAI / LLM Provider
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (local LLM alternative)
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_ENABLED=false

# ==================== P0-3 获客数据源凭据（可选）====================
# 不配置时获客引擎诚实返回 MOCK 示例数据（source_type=MOCK）；
# 配置后 Google 源走真实 Custom Search API（source_type=REAL）。
# GOOGLE_SEARCH_API_KEY=your-google-custom-search-api-key
# GOOGLE_SEARCH_CX=your-google-custom-search-engine-id
# 海关数据源：配置后走真实海关数据 API（source_type=REAL）
# CUSTOMS_API_URL=https://your-customs-data-provider.example.com/api

# ==================== SMTP 邮件发送（可选）====================
# 不配置时跟进邮件诚实返回 NOT_CONFIGURED（不伪造发送成功）；
# 配置后 Lead 跟进邮件走真实 SMTP（source_type=REAL）。
# Gmail 示例：需开启两步验证后生成"应用专用密码"（16 位），
# 地址见 https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=your-account@gmail.com
# SMTP_USE_SSL=false   # Gmail 587 用 STARTTLS(false)；465 端口改 true
# SMTP 代理隧道（可选）：smtplib 不读 HTTP_PROXY 环境变量，
# SMTP 端口被墙阻断时显式配置，例如本机 v2rayN：
# SMTP_PROXY=socks5://127.0.0.1:10808
# Docker 部署时指向宿主机代理：SMTP_PROXY=socks5://host.docker.internal:10808
# 也支持 HTTP CONNECT：SMTP_PROXY=http://127.0.0.1:10809

# ==================== 业务调度器（P0 老板不在线自主经营，可选）====================
# 开启后后台周期执行 active 状态的 Goal（复用 GoalService 真实执行链）。
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=300     # 周期（秒），最小 30
# SCHEDULER_AUTO_ACTIVATE=false      # 自动激活 draft 目标（完全自主，默认关闭）
# SCHEDULER_MAX_GOALS_PER_CYCLE=5    # 单周期最多执行的目标数

PYTHONPATH=.

# Embedding（语义检索）：self_host=Ollama 本地嵌入；生产环境必须配置真实 provider
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
