# LiuHao AI OS - Docker build context exclusions
# 关键：阻止含真实凭据的 .env 进入镜像层

# Secrets（.env.example 保留作为模板）
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes
.github/

# Python
__pycache__
**/__pycache__
*.py[cod]
*.pyo
*.pyd
.venv
venv/
env/
.pytest_cache
.mypy_cache
.coverage
htmlcov/
coverage/
.ruff_cache/
.benchmarks/

# Node / frontend（前端镜像由 frontend/Dockerfile 自行构建）
node_modules
**/node_modules
frontend/dist
frontend/storybook-static
frontend/.storybook

# Database / logs / temp / backups
*.db
*.db-journal
*.sqlite3
logs/
*.log
tmp/
temp/
*.tmp
*.swp
*.zip
backup/
blobs/

# Documentation / IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.md
!README.md
README.md  # 注：保留用于镜像内参考
docs/
scripts/
tests/
audit_package/
compliance/
manifests/
data/

# Misc
alembic.ini
.env.example
